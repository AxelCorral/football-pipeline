# ── API football-data.org ─────────────────────────────────────────────────────
API_KEY=your_football_data_api_key_here
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_BUCKET_NAME=football-pipeline-bucket
AWS_REGION=eu-west-1

# ── Athena ────────────────────────────────────────────────────────────────────
ATHENA_DATABASE=football_db
ATHENA_OUTPUT_S3=s3://football-pipeline-bucket/athena-results/

# ── dbt ───────────────────────────────────────────────────────────────────────
# Schéma dans lequel dbt matérialise ses modèles. Distinct d'ATHENA_DATABASE,
# qui est la base source : dbt n'écrit jamais dans la zone curated.
# Convention : football_analytics_dev en développement, football_analytics en
# production.
DBT_ATHENA_SCHEMA=football_analytics_dev

# Cible dbt par défaut : dev (DuckDB sur data/cache/, aucun credential),
# dev_s3 (DuckDB sur la zone curated S3), athena (production).
DBT_TARGET=dev

# Workgroup Athena utilisé par dbt.
ATHENA_WORKGROUP=primary
